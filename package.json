{
  "name": "pi-tai",
  "version": "0.1.0",
  "description": "A guarded Pi distribution with structured work context, independent session naming, and terminal-aware themes.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test tests/unit/*.test.ts tests/integration/*.test.ts tests/repository/*.test.ts",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:integration": "node --test tests/integration/*.test.ts",
    "test:repository": "node --test tests/repository/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "package:check": "npm pack --dry-run",
    "smoke:isolated": "node tests/smoke/isolated-load.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.80.10",
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@earendil-works/pi-tui": "^0.80.10",
    "@types/node": "^24.10.1",
    "typebox": "^1.3.6",
    "typescript": "^5.9.3"
  },
  "pi": {
    "themes": [
      "./packages/pi-tai/themes"
    ],
    "extensions": [
      "./packages/pi-tai/extension.ts"
    ]
  },
  "files": [
    "packages/pi-tai",
    "README.md",
    "SETTINGS.md",
    "LICENSE"
  ]
}
