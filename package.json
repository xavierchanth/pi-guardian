{
  "name": "pi-tai",
  "version": "0.1.0",
  "description": "A guarded Pi distribution with durable task context, managed isolated workspaces, a Design–Plan–Implement–Confirm subagent workflow, independent session naming, and terminal-aware themes.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xavierchanth/pi-tai.git"
  },
  "homepage": "https://github.com/xavierchanth/pi-tai#readme",
  "bugs": {
    "url": "https://github.com/xavierchanth/pi-tai/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "bins/*"
  ],
  "scripts": {
    "test": "node --test tests/unit/*.test.ts tests/integration/*.test.ts tests/runtime/*.test.ts tests/repository/*.test.ts",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:integration": "node --test tests/integration/*.test.ts",
    "test:runtime": "node --test tests/runtime/*.test.ts",
    "test:repository": "node --test tests/repository/*.test.ts",
    "test:rust": "cargo test --workspace",
    "typecheck": "tsc -p tsconfig.json",
    "protocol:generate": "cargo run -p pi-tai-runtime-protocol --bin export-bindings",
    "protocol:check": "cargo run -p pi-tai-runtime-protocol --bin export-bindings -- --check",
    "runtime:build": "node --experimental-strip-types scripts/runtime-packaging/build.ts all",
    "runtime:smoke": "npm run runtime:build && node --experimental-strip-types scripts/runtime-packaging/smoke.ts all",
    "runtime:package-compare": "npm run runtime:smoke",
    "desktop:dev": "npm run dev --workspace @pi-tai/host-ui",
    "desktop:build": "npm run build --workspace @pi-tai/host-ui",
    "check": "npm run protocol:check && npm run typecheck && npm test && npm run test:rust",
    "package:check": "npm pack --dry-run",
    "smoke:isolated": "node tests/smoke/isolated-load.mjs",
    "eval:subagents": "node --experimental-strip-types evals/subagents/run.ts",
    "eval:guardian": "node --experimental-strip-types evals/guardian/run.ts",
    "eval:agent-concurrency": "node --experimental-strip-types evals/agent-concurrency/run.ts",
    "eval:agent-concurrency:live": "node --experimental-strip-types evals/agent-concurrency/run.ts --live"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.80.10",
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@earendil-works/pi-tui": "^0.80.10",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24.10.1",
    "postject": "1.0.0-alpha.6",
    "typebox": "^1.3.6",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  },
  "pi": {
    "themes": [
      "./packages/pi-tai/themes"
    ],
    "extensions": [
      "./packages/pi-tai/pi-tai.ts"
    ],
    "skills": [
      "./packages/pi-tai/skills"
    ],
    "prompts": [
      "./packages/pi-tai/prompts"
    ]
  },
  "files": [
    "packages/pi-tai",
    "docs",
    "justfile",
    "README.md",
    "SETTINGS.md",
    "LICENSE"
  ],
  "dependencies": {
    "html-to-text": "^10.0.0",
    "ipaddr.js": "^2.4.0",
    "jiti": "^2.7.0",
    "pi-cmux": "^0.1.16"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220"
  }
}
